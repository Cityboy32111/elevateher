generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ─── Users & Auth ───────────────────────────────────────────

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  name           String
  role           String   @default("member") // member, coach, employer_admin, super_admin
  avatarUrl      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  profile        UserProfile?
  orgMemberships OrgMembership[]
  checkIns       CheckIn[]
  riskScores     RiskScore[]
  triggerEvents  TriggerEvent[]
  weekProgress   WeekProgress[]
  coachAssignment CoachAssignment[] @relation("UserAssignments")
  sessions       CoachingSession[]  @relation("UserSessions")
  sentMessages   Message[]          @relation("SentMessages")
  receivedMessages Message[]        @relation("ReceivedMessages")
  podMemberships PodMembership[]
  podPosts       PodPost[]
  podComments    PodComment[]
  toolkitFavorites ToolkitFavorite[]
  notifications  Notification[]
  auditLogs      AuditLog[]
}

model UserProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Onboarding data
  dueDate             DateTime?
  childBirthDate      DateTime?
  leaveStartDate      DateTime?
  returnToWorkDate    DateTime?
  roleLevel           String?  // individual_contributor, manager, director, executive
  roleFunction        String?  // engineering, marketing, sales, hr, finance, operations, legal, other
  workMode            String?  // remote, hybrid, onsite
  managerSupportLevel Int?     // 1-5
  childcareSituation  String?  // set, in_progress, unknown
  topStressors        String?  // JSON array of stressor tags
  topStressorsFreeText String?
  goals               String?  // JSON array of goal tags
  companyType         String?  // startup, midsize, enterprise, nonprofit, government
  supportSystem       String?  // strong, moderate, limited

  // Computed
  currentPhase        Int      @default(1) // 1-5
  currentWeek         Int      @default(1)
  onboardingComplete  Boolean  @default(false)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// ─── Organizations & Employer ───────────────────────────────

model Organization {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  contractType String?  // annual, monthly
  totalSeats   Int      @default(50)
  usedSeats    Int      @default(0)
  logoUrl      String?
  domain       String?  // for SSO matching
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships  OrgMembership[]
  analytics    EmployerAnalyticsFact[]
}

model OrgMembership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           String   @default("member") // member, hr_admin, executive
  enrolledAt     DateTime @default(now())

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

// ─── Content & Weekly Journey ───────────────────────────────

model Phase {
  id          String   @id @default(cuid())
  number      Int      @unique // 1-5
  name        String   // e.g., "Late Pregnancy & Planning"
  description String
  startWeek   Int      // relative week in the 12-month program
  endWeek     Int
  createdAt   DateTime @default(now())

  weekTemplates WeekTemplate[]
}

model WeekTemplate {
  id          String   @id @default(cuid())
  phaseId     String
  weekNumber  Int      // within the phase
  theme       String
  description String?
  createdAt   DateTime @default(now())

  phase       Phase    @relation(fields: [phaseId], references: [id])
  blocks      WeekTemplateBlock[]

  @@unique([phaseId, weekNumber])
}

model ContentBlock {
  id          String   @id @default(cuid())
  type        String   // lesson, task, script, reflection, resource
  title       String
  body        String   // markdown content
  tags        String   // JSON array: phase, theme, work_mode, role_level, risk_tier
  timeMinutes Int      @default(5)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  weekTemplateBlocks WeekTemplateBlock[]
}

model WeekTemplateBlock {
  id             String   @id @default(cuid())
  weekTemplateId String
  contentBlockId String
  position       Int      @default(0)

  weekTemplate   WeekTemplate @relation(fields: [weekTemplateId], references: [id])
  contentBlock   ContentBlock @relation(fields: [contentBlockId], references: [id])

  @@unique([weekTemplateId, contentBlockId])
}

model WeekProgress {
  id              String   @id @default(cuid())
  userId          String
  phaseNumber     Int
  weekNumber      Int
  actionDone      Boolean  @default(false)
  scriptSaved     Boolean  @default(false)
  reflectionText  String?
  checkInDone     Boolean  @default(false)
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, phaseNumber, weekNumber])
}

// ─── Check-Ins & Risk Scoring ───────────────────────────────

model CheckIn {
  id                    String   @id @default(cuid())
  userId                String
  weekNumber            Int
  mood                  Int      // 1-5
  energy                Int      // 1-5
  sleepQuality          Int      // 1-5
  stress                Int      // 1-5
  workloadManageable    Boolean
  managerSupportPresent Boolean
  childcareStable       Boolean
  performanceAnxiety    Boolean
  hardestThisWeek       String?  // free text
  createdAt             DateTime @default(now())

  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RiskScore {
  id          String   @id @default(cuid())
  userId      String
  weekNumber  Int
  score       Int      // 0-100
  tier        String   // low, medium, high, critical
  factors     String   // JSON array of contributing factors
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekNumber])
}

model TriggerEvent {
  id          String   @id @default(cuid())
  userId      String
  riskTier    String
  action      String   // suggest_coach, book_session, stabilize_path, crisis_route
  resolved    Boolean  @default(false)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Coaching ───────────────────────────────────────────────

model CoachProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  bio            String?
  specialties    String?  // JSON array
  maxClients     Int      @default(20)
  currentClients Int      @default(0)
  availability   String?  // JSON: weekly availability windows
  timezone       String   @default("America/New_York")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  assignments    CoachAssignment[] @relation("CoachAssignments")
  sessions       CoachingSession[] @relation("CoachSessions")
  notes          CoachNote[]
}

model CoachAssignment {
  id          String   @id @default(cuid())
  userId      String
  coachId     String
  status      String   @default("active") // active, paused, completed
  assignedAt  DateTime @default(now())

  user        User          @relation("UserAssignments", fields: [userId], references: [id])
  coach       CoachProfile  @relation("CoachAssignments", fields: [coachId], references: [id])

  @@unique([userId, coachId])
}

model CoachingSession {
  id          String   @id @default(cuid())
  userId      String
  coachId     String
  scheduledAt DateTime
  duration    Int      @default(30) // minutes
  status      String   @default("scheduled") // scheduled, completed, cancelled, no_show
  notes       String?
  meetingUrl  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User         @relation("UserSessions", fields: [userId], references: [id])
  coach       CoachProfile @relation("CoachSessions", fields: [coachId], references: [id])
}

model CoachNote {
  id        String   @id @default(cuid())
  coachId   String
  userId    String   // which user this note is about
  content   String
  tags      String?  // JSON array
  createdAt DateTime @default(now())

  coach     CoachProfile @relation(fields: [coachId], references: [id])
}

model Message {
  id          String   @id @default(cuid())
  senderId    String
  receiverId  String
  threadId    String?
  content     String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  sender      User     @relation("SentMessages", fields: [senderId], references: [id])
  receiver    User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
}

// ─── Community Pods ─────────────────────────────────────────

model Pod {
  id          String   @id @default(cuid())
  name        String
  description String?
  matchType   String?  // return_timing, job_type, company_size
  maxMembers  Int      @default(12)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships PodMembership[]
  posts       PodPost[]
  prompts     PodPrompt[]
}

model PodMembership {
  id       String   @id @default(cuid())
  userId   String
  podId    String
  joinedAt DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pod      Pod      @relation(fields: [podId], references: [id], onDelete: Cascade)

  @@unique([userId, podId])
}

model PodPrompt {
  id        String   @id @default(cuid())
  podId     String
  weekNumber Int
  prompt    String
  createdAt DateTime @default(now())

  pod       Pod      @relation(fields: [podId], references: [id], onDelete: Cascade)
}

model PodPost {
  id        String   @id @default(cuid())
  podId     String
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pod       Pod        @relation(fields: [podId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments  PodComment[]
}

model PodComment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  content   String
  createdAt DateTime @default(now())

  post      PodPost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Toolkit ────────────────────────────────────────────────

model Toolkit {
  id          String   @id @default(cuid())
  title       String
  description String
  category    String   // leave_planning, return_to_work, manager_scripts, boundaries, pumping, childcare, sleep, career
  body        String   // markdown content
  tags        String   // JSON array
  phase       Int?     // optional phase association
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  favorites   ToolkitFavorite[]
}

model ToolkitFavorite {
  id        String   @id @default(cuid())
  userId    String
  toolkitId String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  toolkit   Toolkit  @relation(fields: [toolkitId], references: [id], onDelete: Cascade)

  @@unique([userId, toolkitId])
}

// ─── Employer Analytics ─────────────────────────────────────

model EmployerAnalyticsFact {
  id               String   @id @default(cuid())
  organizationId   String
  period           String   // e.g., "2025-W12" or "2025-03"
  totalEnrolled    Int      @default(0)
  activeUsers      Int      @default(0)
  checkInRate      Float    @default(0)
  coachingUtil     Float    @default(0)
  avgRiskScore     Float    @default(0)
  riskDistribution String   // JSON: { low: n, medium: n, high: n, critical: n }
  topPainPoints    String   // JSON array of common tags
  retentionProxy   Float    @default(0) // engagement-based proxy
  createdAt        DateTime @default(now())

  organization     Organization @relation(fields: [organizationId], references: [id])
}

// ─── Notifications & Audit ──────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // weekly_nudge, check_in_reminder, coach_message, risk_alert, pod_activity
  title     String
  body      String
  read      Boolean  @default(false)
  actionUrl String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  String?  // JSON
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id])
}
